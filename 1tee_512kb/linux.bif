//arch = zynqmp; split = false; format = BIN
the_ROM_image:
{
	[bootloader, destination_cpu = a53-0]./platform/export/platform/sw/boot/fsbl.elf
	[pmufw_image]./platform/export/platform/sw/boot/pmufw.elf
	[destination_device = pl]./system_fw.bit
	[destination_cpu = a53-0, exception_level = el-3, trustzone]./common/bl31.elf
	[load = 0x00100000, destination_cpu = a53-0]./platform/export/platform/sw/boot/system.dtb
	[destination_cpu = a53-0, exception_level = el-2]./common/u-boot.elf
}